# --- Garmin Connect ---
# Your Garmin Connect login email. Password & MFA are entered interactively
# on first run (never stored in this file). The auth token is then cached.
GARMIN_EMAIL=you@example.com

# Where the cached Garmin auth token lives (so we don't re-login every run,
# which is what triggers rate-limit lockouts). Default is fine.
GARMIN_TOKEN_STORE=~/.garminconnect

# --- Optional informational free-text provider ---
# Consequential coaching decisions and actions are deterministic. The selected
# provider can answer informational Telegram free text but has no mutation,
# scheduling, or workout-authoring authority.
# ollama = free/local. claude or gemini require their respective API key.
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
# Only needed if LLM_PROVIDER=claude:
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5
# Only needed if LLM_PROVIDER=gemini:
GEMINI_API_KEY=
# gemini-2.5-flash: best free-tier choice (high quota, fast, big context).
# gemini-2.5-pro reasons better but has much tighter free-tier rate limits.
GEMINI_MODEL=gemini-2.5-flash
# Optional output controls for Gemini:
# GEMINI_TEMPERATURE=0.5
# GEMINI_MAX_OUTPUT_TOKENS=1500
# AI-first intent router. Shadow records classifications without changing replies;
# guarded enables deterministic dispatch after the shadow acceptance review.
CHAT_ROUTER_MODE=shadow
CHAT_DIALOGUE_TTL_MINUTES=30

# --- Sync ---
# How many days of history to backfill on first sync.
INITIAL_BACKFILL_DAYS=90
# Normal incremental sync times (24h, comma-separated HH:MM values).
AUTO_SYNC_TIMES=19:00
# Garmin rate-limit cooldown before another request is attempted.
# GARMIN_429_COOLDOWN_MINUTES=30
# Minimum interval for the slower workout-history refresh.
# WORKOUT_SYNC_INTERVAL_HOURS=24
# Morning priority polling window and cadence. The decision deadline is fixed
# at 11:30 local time.
# MORNING_WATCH_INTERVAL_MINUTES=15
# MORNING_WATCH_START_HOUR=7
# MORNING_WATCH_END_HOUR=12

# --- App ---
HOST=0.0.0.0
PORT=8000
# SQLite DB file (relative to project root unless absolute).
DB_PATH=garmincoach.db
# App login (protects the whole UI with a cookie-based session).
# Leave APP_USERNAME blank to disable app-level auth.
APP_USERNAME=coach
# REQUIRED if APP_USERNAME is set. Choose a strong password — do not ship a default.
APP_PASSWORD=

# iCloud or Google Calendar ICS Secret URL for schedule syncing
ICS_CALENDAR_URL=
# Secret for signing session cookies. REQUIRED when APP_USERNAME is set — the
# app refuses to start with the default value below. Generate a real one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-to-a-random-string
# How many days the login cookie persists (default 30).
# SESSION_MAX_AGE_DAYS=30

# --- Telegram coach and notifications (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Use a unique random value and configure the Telegram webhook with the same
# secret. Do not expose it in logs or screenshots.
TELEGRAM_WEBHOOK_SECRET=
